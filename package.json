{
  "name": "maritime-radio-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,session \"vite --host 0.0.0.0\" \"node server/sessionServer.mjs\"",
    "dev:free-ports": "node scripts/free-dev-ports.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:session": "node server/sessionServer.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
